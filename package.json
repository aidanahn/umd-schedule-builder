{
  "name": "umd-schedule-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "next build --webpack",
    "compare": "tsx src/cli/compare-snapshots.ts",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up -d --wait",
    "dev": "next dev",
    "ingest:db": "tsx src/cli/ingest-db.ts",
    "ingest:all": "tsx src/cli/ingest-all.ts",
    "ingest:worker": "tsx src/cli/ingest-worker.ts",
    "scrape": "tsx src/cli/scrape.ts",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:db": "RUN_DB_TESTS=true vitest run --no-file-parallelism src/db/*.integration.test.ts",
    "test:live": "RUN_LIVE_TESTS=true vitest run src/testudo/*.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
