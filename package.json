{
  "name": "umd-schedule-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compare": "tsx src/cli/compare-snapshots.ts",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up -d --wait",
    "ingest:db": "tsx src/cli/ingest-db.ts",
    "scrape": "tsx src/cli/scrape.ts",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:db": "RUN_DB_TESTS=true vitest run --no-file-parallelism src/db/*.integration.test.ts",
    "test:live": "RUN_LIVE_TESTS=true vitest run src/testudo/*.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  }
}
