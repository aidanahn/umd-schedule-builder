{
  "name": "umd-schedule-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compare": "tsx src/cli/compare-snapshots.ts",
    "scrape": "tsx src/cli/scrape.ts",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:live": "RUN_LIVE_TESTS=true vitest run src/testudo/*.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}
